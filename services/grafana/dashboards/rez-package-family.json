          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM rez_context_event\nWHERE $__timeFilter(received_at) AND action = 'created' AND status <> 'solved' AND EXISTS (SELECT FROM unnest(package_requests) AS request WHERE request ~ ('^[~!]?' || '$family' || '([-=<>@#].*)?$'))"
