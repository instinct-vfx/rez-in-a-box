    {
      "type": "table",
      "title": "Users by version",
      "description": "Pick versions at the top to see who still uses them. Click a user for their events.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT username AS \"User\",\n       substr(pkg, length('$family') + 2) AS \"Version\",\n       count(DISTINCT host) AS \"Hosts\",\n       count(*) AS \"Contexts\",\n       max(received_at) AS \"Last used\"\nFROM rez_context_event, unnest(resolved_packages) AS pkg\nWHERE $__timeFilter(received_at) AND split_part(pkg, '-', 1) = '$family'\n  AND ('__all__' IN ($version) OR substr(pkg, length('$family') + 2) IN ($version))\nGROUP BY 1, 2\nORDER BY 5 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
