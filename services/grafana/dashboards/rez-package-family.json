    {
      "type": "table",
      "title": "Versions",
      "description": "First and last seen within the selected time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT substr(pkg, length('$family') + 2) AS \"Version\",\n       count(*) AS \"Contexts\",\n       count(DISTINCT username) AS \"Users\",\n       count(DISTINCT host) AS \"Hosts\",\n       min(received_at) AS \"First seen\",\n       max(received_at) AS \"Last seen\",\n       100.0 * count(*) / sum(count(*)) OVER () AS \"Share\"\nFROM rez_context_event, unnest(resolved_packages) AS pkg\nWHERE $__timeFilter(received_at) AND split_part(pkg, '-', 1) = '$family'\nGROUP BY 1\nORDER BY max(received_at) DESC, min(received_at) DESC"
        }
      ],
      "fieldConfig": {
