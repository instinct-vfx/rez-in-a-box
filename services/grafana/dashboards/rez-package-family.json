    {
      "type": "timeseries",
      "title": "Solve time of resolves with this package",
      "description": "Resolves that weren't served from the cache.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "interval": "6h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(received_at, $__interval),\n       avg(solve_time) AS \"Average\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY solve_time) AS \"95th percentile\"\nFROM rez_context_event\nWHERE $__timeFilter(received_at) AND action = 'created' AND status = 'solved' AND from_cache IS NOT TRUE AND EXISTS (SELECT FROM unnest(resolved_packages) AS pkg WHERE split_part(pkg, '-', 1) = '$family')\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "barAlignment": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
