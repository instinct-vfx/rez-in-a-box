    {
      "type": "table",
      "title": "How it is requested",
      "description": "Explicit version requests keep people on older versions.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT request AS \"Request\",\n       count(*) AS \"Contexts\",\n       count(DISTINCT username) AS \"Users\",\n       max(received_at) AS \"Last used\"\nFROM rez_context_event, unnest(package_requests) AS request\nWHERE $__timeFilter(received_at) AND action = 'created'\n  AND request ~ ('^[~!]?' || '$family' || '([-=<>@#].*)?$')\nGROUP BY 1\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
