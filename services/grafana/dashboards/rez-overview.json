    {
      "type": "stat",
      "title": "Failed resolves",
      "description": "Share of created contexts that didn't resolve.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status <> 'solved') / nullif(count(*), 0)\nFROM rez_context_event WHERE $__timeFilter(received_at) AND action = 'created'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 2,
                "color": "orange"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
