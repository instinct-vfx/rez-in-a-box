    {
      "type": "table",
      "title": "Recent failed resolves",
      "description": "The reason is only sent if failure_description is in rez's context_tracking_context_fields.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
