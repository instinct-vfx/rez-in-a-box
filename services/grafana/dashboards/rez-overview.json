          "rawQuery": true,
          "rawSql": "SELECT request AS \"Request\",\n       count(*) AS \"Contexts\",\n       count(DISTINCT username) AS \"Users\"\nFROM rez_context_event, unnest(package_requests) AS request\nWHERE $__timeFilter(received_at) AND action = 'created'\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 25"
