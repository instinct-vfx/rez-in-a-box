    {
      "type": "stat",
      "title": "Cache hits",
      "description": "Share of resolves served from rez's resolve cache (memcached).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * avg(from_cache::int)\nFROM rez_context_event WHERE $__timeFilter(received_at) AND action = 'created' AND status = 'solved'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
