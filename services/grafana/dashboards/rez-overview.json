            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS \"Time\",\n       username AS \"User\",\n       host AS \"Host\",\n       array_to_string(package_requests, ' ') AS \"Request\",\n       regexp_replace(context->>'failure_description',\n                      '^The context failed to resolve:[[:space:]]*', '') AS \"Reason\",\n       id AS \"Event\"\nFROM rez_context_event\nWHERE $__timeFilter(received_at) AND status <> 'solved'\nORDER BY received_at DESC\nLIMIT 100"
        }
