    {
      "type": "table",
      "title": "Most used packages",
      "description": "Click a package to see its versions and users.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT split_part(pkg, '-', 1) AS \"Package\",\n       count(*) AS \"Contexts\",\n       count(DISTINCT username) AS \"Users\",\n       count(DISTINCT pkg) AS \"Versions\",\n       max(received_at) AS \"Last used\"\nFROM rez_context_event, unnest(resolved_packages) AS pkg\nWHERE $__timeFilter(received_at)\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": true,
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Package"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show package family",
                    "url": "/d/rez-package-family/?var-family=${__value.raw}&${__url_time_range}"
                  }
                ]
