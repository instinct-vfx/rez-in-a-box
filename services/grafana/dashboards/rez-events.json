  "panels": [
    {
      "type": "timeseries",
      "title": "Events",
      "description": "Drag across the chart to zoom into a time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(received_at, $__interval, 0), action AS metric, count(*) AS value\nFROM rez_context_event\nWHERE $__timeFilter(received_at)\n  AND ('__all__' IN ($user) OR username IN ($user))\n  AND ('__all__' IN ($action) OR action IN ($action))\n  AND ('__all__' IN ($status) OR status IN ($status))\n  AND ('$host' = '' OR host ILIKE '%$host%')\n  AND ('$package' = ''\n       OR resolved_packages @> ARRAY['$package']\n       OR EXISTS (SELECT FROM unnest(resolved_packages) AS pkg\n                  WHERE split_part(pkg, '-', 1) = '$package'))\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
