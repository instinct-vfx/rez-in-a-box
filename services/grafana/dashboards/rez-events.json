    {
      "type": "table",
      "title": "Events (latest 1,000)",
      "description": "Click an event id for the full context.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rez-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rez-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT received_at AS \"Time\",\n       id AS \"Event\",\n       action AS \"Action\",\n       username AS \"User\",\n       host AS \"Host\",\n       status AS \"Status\",\n       solve_time AS \"Solve time\",\n       from_cache AS \"Cached\",\n       rez_version AS \"rez\",\n       array_to_string(package_requests, ' ') AS \"Request\",\n       array_to_string(resolved_packages, ' ') AS \"Resolved\"\nFROM rez_context_event\nWHERE $__timeFilter(received_at)\n  AND ('__all__' IN ($user) OR username IN ($user))\n  AND ('__all__' IN ($action) OR action IN ($action))\n  AND ('__all__' IN ($status) OR status IN ($status))\n  AND ('$host' = '' OR host ILIKE '%$host%')\n  AND ('$package' = ''\n       OR resolved_packages @> ARRAY['$package']\n       OR EXISTS (SELECT FROM unnest(resolved_packages) AS pkg\n                  WHERE split_part(pkg, '-', 1) = '$package'))\nORDER BY received_at DESC\nLIMIT 1000"
        }
      ],
